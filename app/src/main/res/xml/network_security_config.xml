<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- 默认只走 https -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 教务系统的例外：不少学校内网只有一个 http 入口，密码虽然先过 RSA 加密，
         但 JSESSIONID、学号、课表 JSON 在链路上还是明文，同一校园网里可被嗅探。
         所以这里只给教育网域名开口子，别的一律禁掉。
         你学校的教务如果是 http 又不在 edu.cn / edu 下，把域名加到这个列表里。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">edu.cn</domain>
        <domain includeSubdomains="true">edu</domain>
    </domain-config>

    <!-- 本机回环：adb reverse 调试、以及自己搭的反向代理 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

</network-security-config>
